{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PandaTerm",
  "version": "0.1.0",
  "identifier": "com.pandaterm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace apps/desktop-ui",
    "beforeBuildCommand": "npm run build --workspace apps/desktop-ui",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../apps/desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PandaTerm",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}